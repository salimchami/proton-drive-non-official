{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drive-sync",
  "version": "0.1.0",
  "identifier": "net.salimchami.drivesync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "drive-sync",
        "width": 520,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libsecret-tools", "libglib2.0-bin"],
        "files": {
          "/usr/lib/drive-sync/node": "../../packaging/build/node/bin/node",
          "/usr/lib/drive-sync/daemon/main.mjs": "../../daemon/dist/main.mjs",
          "/usr/lib/systemd/user/drive-sync.service": "../../packaging/systemd/drive-sync.service",
          "/usr/share/doc/drive-sync/node-LICENSE": "../../packaging/build/node/LICENSE"
        },
        "postInstallScript": "../../packaging/debian/postinst",
        "preRemoveScript": "../../packaging/debian/prerm"
      }
    }
  }
}
